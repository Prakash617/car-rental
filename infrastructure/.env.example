# ==========================================
# Car Rental SaaS — Environment Variables Template
# ==========================================

# --- Django Core ---
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,.platform.com

# --- PostgreSQL Database ---
POSTGRES_DB=car_rental
POSTGRES_USER=car_rental_user
POSTGRES_PASSWORD=secure_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://car_rental_user:secure_dev_password@postgres:5432/car_rental

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email Configuration ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@platform.com

# --- Storage Provider ---
STORAGE_PROVIDER=local

# --- Payment Gateways ---
PAYMENT_PROVIDER=stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ESEWA_MERCHANT_ID=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
